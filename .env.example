# =============================================================================
# LOCALVIDEO AI — CONTROL PLANE — CONFIGURAÇÃO (Fase 1)
# Copie para `.env` na raiz do projeto e ajuste. NUNCA versione o `.env` real.
# =============================================================================

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------
LV_ENVIRONMENT=development
LV_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Chaves da API própria do LocalVideo AI (§10)
# O desktop client usa LV_LOCALVIDEO_API_KEY.
# Operações que geram cobrança (start/stop/destroy) exigem LV_LOCALVIDEO_ADMIN_API_KEY.
# SEM CHAVE CONFIGURADA, as rotas autenticadas respondem 503 (fail-closed).
# -----------------------------------------------------------------------------
LV_LOCALVIDEO_API_KEY=troque-por-uma-chave-longa-e-aleatoria
LV_LOCALVIDEO_ADMIN_API_KEY=troque-por-outra-chave-longa-e-aleatoria

# -----------------------------------------------------------------------------
# Vast.ai (§3)
# A chave da Vast.ai fica SOMENTE AQUI, no servidor de controle.
# Crie em: https://console.vast.ai/manage-keys/
# NUNCA envie essa chave ao aplicativo desktop.
# -----------------------------------------------------------------------------
LV_VAST_API_KEY=
LV_VAST_SERVER_URL=https://console.vast.ai

# PORTÃO DE COBRANÇA (§14): false = NENHUMA instância/volume é criado ou
# destruído. Para permitir operações reais (com custo), defina true
# EXPLICITAMENTE junto de LV_VAST_API_KEY e dos limites de custo abaixo.
LV_VAST_ENABLE_MUTATIONS=false

# Retry/backoff (semântica igual ao SDK oficial: 429, 502, 503, 504 + rede)
LV_VAST_RETRY_ATTEMPTS=3
LV_VAST_BACKOFF_BASE_SECONDS=0.15
LV_VAST_BACKOFF_FACTOR=1.5
LV_VAST_MAX_RETRY_AFTER_SECONDS=60
LV_VAST_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Controle financeiro (§8)
# -----------------------------------------------------------------------------
LV_GPU_MONTHLY_BUDGET_BRL=100
LV_USD_TO_BRL_RATE=5.40
LV_BUDGET_ALERT_THRESHOLD=0.70
LV_BUDGET_BLOCK_THRESHOLD=0.90
LV_ESTIMATED_SESSION_HOURS=1.0
LV_STORAGE_RESERVE_BRL=5

# -----------------------------------------------------------------------------
# GPU Manager / Idle Manager (§6/§7)
# -----------------------------------------------------------------------------
LV_GPU_AUTO_START=true
LV_GPU_AUTO_STOP=true
LV_GPU_IDLE_TIMEOUT_MINUTES=10
LV_GPU_MAX_CONCURRENT_JOBS=1
LV_INSTANCE_POLL_INTERVAL_SECONDS=5
LV_INSTANCE_READY_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# Perfil de hardware EDITÁVEL (§4) — não fixa RTX 4090
# Lista aceita JSON ou separada por vírgula.
# -----------------------------------------------------------------------------
LV_GPU_PREF_ALLOWED_GPUS=["RTX 4090","RTX 4090D","RTX 5090","A100 PCIE","A100 SXM4","H100","H100 SXM","L40S"]
LV_GPU_PREF_MIN_VRAM_MB=24576
LV_GPU_PREF_MIN_RAM_MB=32768
LV_GPU_PREF_MIN_DISK_GB=60
LV_GPU_PREF_MIN_RELIABILITY=0.98
LV_GPU_PREF_MIN_COMPUTE_CAP=8.0
LV_GPU_PREF_CUDA_MIN=11.8
LV_GPU_PREF_MAX_DPH_TOTAL=

# -----------------------------------------------------------------------------
# Armazenamento persistente (§5)
# -----------------------------------------------------------------------------
LV_DATA_DIR=./data
LV_VOLUME_MOUNT_PATH=/data
LV_VOLUME_DEFAULT_SIZE_GB=100

# -----------------------------------------------------------------------------
# Segurança HTTP (§10)
# -----------------------------------------------------------------------------
LV_RATE_LIMIT_REQUESTS_PER_MINUTE=60
LV_RATE_LIMIT_BURST=20
LV_MAX_REQUEST_BODY_BYTES=10485760
LV_CORS_ORIGINS=["http://localhost:1420","http://localhost:5173"]

# -----------------------------------------------------------------------------
# Reservado para fases seguintes (PostgreSQL/Redis — Fase 6)
# -----------------------------------------------------------------------------
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=localvideo
# POSTGRES_USER=localvideo
# POSTGRES_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

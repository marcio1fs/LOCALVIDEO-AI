# ---- CRM de atendimento ----
CRM_PORT=4000
CRM_HOST=0.0.0.0
# Arquivo de persistência dos dados (omitir = server/data.json)
# CRM_DATA_FILE=/data/crm-data.json

# ---- Notificações por e-mail (SMTP) ----
# Se omitido, o CRM fica em modo dev (notificações no app + log no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CRM Atendimento <noreply@empresa.com>

# ---- Integração com instância n8n ----
# Base da instância n8n (Cloud ou self-hosted). Se definida, o CRM repassa
# os eventos para os webhooks da n8n: https://<base>/webhook/<caminho>
N8N_BASE_URL=https://mastercrm.app.n8n.cloud
# Chave de API do n8n (para o script de importação de fluxos)
# n8n -> Settings -> API -> Create API key
N8N_API_KEY=

# ---- URL pública do CRM (Vercel) ----
# Domínio do deploy na Vercel. Usada para mostrar as URLs de callback/webhook
# na tela de Configurações. No Vercel, defina CRM_URL=https://<seu-dominio>.vercel.app
CRM_URL=https://crm-nine-eta-26.vercel.app

# ---- Vercel KV (persistência na Vercel) ----
# No Vercel: Storage -> Create -> KV. Em seguida, em Project Settings -> Variables,
# adicione KV_URL, KV_REST_API_TOKEN e KV_NAMESPACE_ID (disponíveis no dashboard do KV).
# Se definidos, o CRM persiste em KV; senão, usa arquivo local (server/data.json).
KV_URL=
KV_REST_API_TOKEN=
KV_NAMESPACE_ID=

# ---- n8n (Docker) ----
N8N_HOST=n8n.localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-this-to-a-long-random-secret
WEBHOOK_BASE_PATH=/webhook
DB_TYPE=postgresdb

# Conexão Postgres do n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n
POSTGRES_DB=n8n

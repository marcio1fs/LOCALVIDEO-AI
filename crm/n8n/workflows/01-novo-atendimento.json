    {
      "parameters": {
        "jsCode": "// Roteamento de atendimento: define o atendente e calcula a meta SLA.\nconst payload = $input.first().json.body || $input.first().json;\n\nconst canais = ['chat', 'email', 'telefone', 'presencial'];\nconst canal = canais.includes(payload.canal) ? payload.canal : 'chat';\n\n// Fila simples de atendentes (adaptar conforme a equipe real)\nconst fila = ['Ana Borges', 'Bruno Costa', 'Carla Lima'];\nconst atendente = fila[Math.floor(Math.random() * fila.length)];\n\n// SLA alvo (minutos) por canal\nconst slaPorCanal = { chat: 15, email: 60, telefone: 30, presencial: 120 };\nconst slaMinutos = slaPorCanal[canal];\n\nconst slaDue = new Date(Date.now() + slaMinutos * 60000).toISOString();\n\nreturn [{\n  json: {\n    clienteId: payload.clienteId || null,\n    clienteNome: payload.clienteNome || 'Cliente',\n    assunto: payload.assunto || 'Novo atendimento',\n    canal,\n    atendente,\n    slaMinutos,\n    slaDue,\n    rotado: true\n  }\n}];"
      },
      "id": "2f430d10-4ab3-4402-8f9d-ab73624c7f3c",
      "name": "Rotear Atendimento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [230, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "947889af-4d00-4bcc-8fb4-54643baea91e",
              "leftValue": "={{ $json.canal }}",
              "rightValue": "email",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ef293d12-c7e2-46c4-871a-0b2d0f29a106",

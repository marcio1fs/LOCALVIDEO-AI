      "parameters": {
        "jsCode": "// Registrar a mensagem no atendimento e calcular se há risco de SLA.\nconst body = $input.first().json.body || $input.first().json;\n\nconst atendimento = $('Rotear Interação').first().json;\n\nconst agora = Date.now();\nconst atrasado = atendimento.slaDue && new Date(atendimento.slaDue).getTime() < agora;\n\n// Se o cliente escreveu após o SLA, sinaliza resolução priorizada\nconst prioridade = atrasado ? 'urgente' : 'normal';\n\nreturn [{\n  json: {\n    atendimentoId: body.atendimentoId,\n    autor: body.autor || 'cliente',\n    texto: body.texto,\n    prioridade,\n    atrasado\n  }\n}];"
      },
      "id": "4bb4c6c3-fef4-40d7-8ca3-7ae586c45e5b",

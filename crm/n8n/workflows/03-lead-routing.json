    {
      "parameters": {
        "jsCode": "// Pontuação de lead: define o valor e a maturidade do contato.\nconst body = $input.first().json.body || $input.first().json;\n\nlet pontos = 0;\nif (body.email) pontos += 20;\nif (body.telefone) pontos += 20;\nif (body.empresa) pontos += 25;\nif (body.tags && body.tags.includes('corporativo')) pontos += 30;\nif (body.tags && body.tags.includes('vip')) pontos += 25;\n\nconst valor = pontos >= 60 ? 15000 : pontos >= 35 ? 5000 : 0;\n\nreturn [{\n  json: {\n    nome: body.nome || 'Lead',\n    email: body.email || '',\n    telefone: body.telefone || '',\n    empresa: body.empresa || '',\n    tags: body.tags || ['novo'],\n    status: pontos >= 60 ? 'ativo' : pontos >= 35 ? 'potencial' : 'potencial',\n    pontos,\n    valor,\n    origem: body.origem || 'webhook'\n  }\n}];"
      },
      "id": "eda5f3c3-4633-412a-8250-b59ffcda423a",
      "name": "Pontuar Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [230, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "ruleName": "VIP",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "e2c4d761-ae16-4df3-b4cc-34e675ac98df",
                    "leftValue": "={{ $json.pontos }}",
                    "rightValue": 60,
                    "operator": { "type": "number", "operation": "gte" }
                  }
                ],
                "combinator": "and"
              },
              "renameExisting": false,
              "renameExistingOutput": false
            },
            {
              "ruleName": "Médio",
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },

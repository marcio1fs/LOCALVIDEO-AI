                    "leftValue": "={{ $json.pontos }}",
                    "rightValue": 35,
                    "operator": { "type": "number", "operation": "gte" }
                  }
                ],
                "combinator": "and"
              },
              "renameExisting": false,
              "renameExistingOutput": false
            }
          ],

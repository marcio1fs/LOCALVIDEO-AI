      "parameters": {
        "jsCode": "// Processa a mensagem do Telegram e prepara o atendimento.\nconst msg = $input.first().json;\nconst texto = (msg.text || msg.message_text || '').trim();\nconst chatId = msg.chat_id || msg.chatId;\nconst deUsuario = msg.from && (msg.from.first_name || msg.from.username) || 'Cliente Telegram';\n\nreturn [{\n  json: {\n    clienteNome: deUsuario,\n    texto,\n    chatId,\n    assunto: texto.slice(0, 40) || 'Telegram'\n  }\n}];"
      },
      "id": "589c090a-ec8c-48df-a6e2-c5894d4c4e56",
      "name": "Processar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [230, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://seu-app.vercel.app/api/atendimentos",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"clienteNome\": $json.clienteNome,\n  \"assunto\": $json.assunto,\n  \"canal\": \"chat\",\n  \"atendente\": \"Telegram\"\n}",
        "options": {}
      },
